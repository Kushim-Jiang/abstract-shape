# Auto detect text files and perform LF normalization
* text=auto

# 检入时统一 LF，检出时不改（避免 Windows 上反复出现整文件行尾 diff）
*.py    text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.ndjson text eol=lf
input/*.txt  text eol=lf

# 二进制
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.zip binary
